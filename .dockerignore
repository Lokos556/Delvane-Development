# Only runtime inputs enter the build context. Add future runtime assets explicitly.
**
!Dockerfile
!requirements.txt
!requirements-production.txt
!start_production.sh
!app.py
!static/
!static/**

# Deny sensitive/generated files even inside an allowed asset directory.
**/.env
**/.env.*
**/*.env
**/*.db
**/*.db-*
**/*.sqlite*
**/*.db3*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.crt
**/*.cer
**/*.jks
**/credentials*
**/service-account*.json
**/secrets/**
**/.aws/**
**/.ssh/**
**/certs/**
**/certificates/**
**/__pycache__/**
**/*.pyc
**/*.log
