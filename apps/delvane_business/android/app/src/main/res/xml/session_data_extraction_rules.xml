<?xml version="1.0" encoding="utf-8"?>
<!-- Never migrate encrypted session preferences onto another device without
     the Android Keystore key. allowBackup=false also disables app cloud backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
