# LOCAL DEVELOPMENT EXAMPLE
ROSA_APP_ENV=development
ROSA_DATABASE_URL=sqlite:///rosa.db
# Optional override. Windows defaults to %LOCALAPPDATA%\Rosa so updates reuse data.
ROSA_DATA_DIR=
ROSA_SECURE_COOKIES=0
ROSA_DEMO_MODE=1
ROSA_REQUIRE_COMPLETE_CHECKLIST=0

# Rosa Intelligence. LOCAL-FIRST is always the routing strategy.
# local = database/operations/action engine only, with zero external AI calls.
# openai = same local-first router, but Luna may answer ONLY the fallback/complex route.
ROSA_AI_PROVIDER=local
ROSA_OPENAI_API_KEY=
ROSA_OPENAI_MODEL=gpt-5.6-luna
ROSA_OPENAI_REASONING_EFFORT=none
ROSA_AI_TIMEOUT_SECONDS=25
# Leave blank locally: Rosa uses a DEVELOPMENT-ONLY local encryption key.
ROSA_ENCRYPTION_KEY=
# Shared commercial transport. These belong to Rosa's hosted backend, never to customers.
ROSA_CHANNEX_API_KEY=
ROSA_CHANNEX_BASE_URL=https://staging.channex.io
ROSA_CHANNEX_POLL_SECONDS=60
ROSA_CHANNEX_ARI_SEND_SECONDS=6
ROSA_CHANNEL_BRIDGE_API_KEY=
ROSA_CHANNEL_BRIDGE_WEBHOOK_SECRET=
# Enable only after MTÜ has issued Rosa's commercial NTAK and VIZA approvals.
ROSA_MTU_CERTIFIED=0

# PRODUCTION MUST INSTEAD USE VALUES LIKE:
# ROSA_APP_ENV=production
# ROSA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/rosa?sslmode=require
# ROSA_SECURE_COOKIES=1
# ROSA_DEMO_MODE=0
# ROSA_REQUIRE_COMPLETE_CHECKLIST=1
# ROSA_AI_PROVIDER=openai  # optional Luna fallback only
# ROSA_OPENAI_API_KEY=<SECRET FROM YOUR HOST'S SECRET STORE>
# ROSA_OPENAI_MODEL=gpt-5.6-luna
# ROSA_OPENAI_REASONING_EFFORT=none
# ROSA_ENCRYPTION_KEY=<FERNET KEY FROM YOUR HOST'S SECRET STORE>
# ROSA_CHANNEL_BRIDGE_API_KEY=<ROSA'S CHANNEL-MANAGER KEY>
# ROSA_CHANNEL_BRIDGE_WEBHOOK_SECRET=<LONG RANDOM SECRET>
# ROSA_MTU_CERTIFIED=1  # only after written MTÜ approval
# Generate a Fernet key locally with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
